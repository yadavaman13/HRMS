# ==========================================
# Dayflow HRMS - Master Environment Template
# ==========================================

# ── Server / API Config ───────────────────
NODE_ENV=development
SERVER_PORT=3000
SERVER_URL=http://localhost:3000
CLIENT_ORIGINS=http://localhost:5173

# ── Database (PostgreSQL + Drizzle) ───────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hrms_db

# ── Security & Authentication ─────────────
JWT_SECRET=super-secret-jwt-key-change-this-in-production-min-32-chars

# ── Cache & Session (Redis) ───────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Client / Frontend Config ──────────────
VITE_API_BASE_URL=http://localhost:3000

# ── Third-Party Integrations (Optional) ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SENDER_EMAIL=
IMAGEKIT_PRIVATE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
GEMINI_API_KEY=
MISTRAL_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX=
TAVILY_API_KEY=
LLAMA_CLOUD_API_KEY=
